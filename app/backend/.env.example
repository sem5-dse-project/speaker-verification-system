PORT=5000

# PostgreSQL + pgvector (required). Example: Docker
#   docker run -d --name voice-auth-pg -e POSTGRES_USER=voice_auth -e POSTGRES_PASSWORD=password -e POSTGRES_DB=voice_authentication -p 5433:5432 pgvector/pgvector:pg16
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=voice_auth
DATABASE_PASSWORD=password
DATABASE_NAME=voice_authentication

# Optional: copy old MySQL/MariaDB data → Postgres (npm run migrate:from-mysql)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-mysql-password
# MYSQL_DATABASE=voice_authentication

JWT_SECRET=replace_with_a_secure_secret

# Comma-separated browser origins (Docker/K8s frontends)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

ML_SERVER_URL=http://localhost:8000
REQUIRED_ENROLLMENT_SAMPLES=3
DEFAULT_VERIFY_THRESHOLD=0.25
IDENTIFY_THRESHOLD=0.25
IDENTIFY_MARGIN=0.05
REPLAY_DETECTION=true
