PORT=8000
HOST=0.0.0.0
DEVICE=cpu
SAMPLE_RATE=16000
MAX_SECONDS=4.0
DEFAULT_THRESHOLD=0.25
ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
# ECAPA_SAVEDIR=./pretrained_models/spkrec-ecapa-voxceleb
REPLAY_ENABLED=true
# Defaults to mixed 2017+PA2019 LFCC checkpoint
# REPLAY_CHECKPOINT=../../replay-cnn-baseline/experiments/lfcc_vs_mel_compare/runs/lfcc/best_lfcc_mixed_2017_pa2019.pt
# Optional center threshold override (otherwise uses checkpoint EER thr)
# REPLAY_THRESHOLD=
# Dual band: LIVE < center-margin <= UNCERTAIN < center+margin <= REPLAY
# REPLAY_MARGIN=0.10
# Or set absolute cuts (overrides margin):
# REPLAY_T_LOW=0.64
# REPLAY_T_HIGH=0.84
