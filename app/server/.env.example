PORT=8000
HOST=0.0.0.0
DEVICE=cpu
SAMPLE_RATE=16000
MAX_SECONDS=4.0
DEFAULT_THRESHOLD=0.45
# Speech activity gate — rejects ambient "empty" mic that still has RMS ~0.02–0.04
MIN_SPEECH_RMS=0.01
MIN_SPEECH_FRAME_RMS=0.08
MIN_SPEECH_MS=350
MIN_SPEECH_STRONG_FRAME_RMS=0.10
MIN_SPEECH_STRONG_MS=200
MIN_SPEECH_PEAK=0.40
ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
REPLAY_ENABLED=true
# REPLAY_CHECKPOINT=../../replay-cnn-baseline/experiments/inverted_mel_mixed_2017_pa2019/runs/inverted_mel_mixed/best_inverted_mel_mixed_2017_pa2019.pt
# REPLAY_MARGIN=0.10
