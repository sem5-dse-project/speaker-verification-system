PORT=8000
HOST=0.0.0.0
DEVICE=cpu
# Comma-separated list of allowed CORS origins (Express backend + Vite frontend)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
SAMPLE_RATE=16000
MAX_SECONDS=4.0
DEFAULT_THRESHOLD=0.5
#ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
ECAPA_SOURCE=./pretrained_models/spkrec-ecapa-voxceleb
REPLAY_ENABLED=false
# Defaults to mixed 2017+PA2019 inverted-Mel checkpoint (better cross-corpus generalization)
# REPLAY_CHECKPOINT=../../replay-cnn-baseline/experiments/inverted_mel_mixed_2017_pa2019/runs/inverted_mel_mixed/best_inverted_mel_mixed_2017_pa2019.pt
# REPLAY_MARGIN=0.10
# Optional LA (synthetic). LFCC is safer for browser-mic hard gating.
# WavLM (ASVspoof LA ~7.6% EER) often scores ~1.0 on laptop mics — use soft only.
LA_ENABLED=false
LA_HARD_GATE=false
LA_BACKEND=lfcc
# LA_CHECKPOINT=../../replay-cnn-baseline/experiments/lfcc_la2019/runs/lfcc_la/best_lfcc_la2019.pt
# Try WavLM soft: LA_BACKEND=wavlm, LA_HARD_GATE=false
# LA_CHECKPOINT=../../replay-cnn-baseline/experiments/wavlm_la2019/runs/wavlm_la/best_wavlm_la2019.pt
# LA_MARGIN=0.10

# Fusion Gate (cross-attention) -> self_attention | noise_aware
FUSION_MODEL_TYPE=self_attention
FUSION_MODEL_PATH="./checkpoints/self_attention_final.pt"


# Choose: webrtc | deepfilternet | none
ENHANCEMENT_MODE=webrtc
FUSION_ENABLED=true

# Make sure to use GPU if available
DEVICE=cpu
