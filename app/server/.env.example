PORT=8000
HOST=0.0.0.0
DEVICE=cpu
SAMPLE_RATE=16000
MAX_SECONDS=4.0
DEFAULT_THRESHOLD=0.5
#ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
ECAPA_SOURCE=./pretrained_models/spkrec-ecapa-voxceleb
REPLAY_ENABLED=false
# Defaults to mixed 2017+PA2019 inverted-Mel checkpoint (better cross-corpus generalization)
# REPLAY_CHECKPOINT=../../replay-cnn-baseline/experiments/inverted_mel_mixed_2017_pa2019/runs/inverted_mel_mixed/best_inverted_mel_mixed_2017_pa2019.pt
# Optional override (otherwise uses threshold stored in the checkpoint)
# REPLAY_THRESHOLD=

# Fusion Gate (cross-attention) -> self_attention | noise_aware
FUSION_MODEL_TYPE=self_attention
FUSION_MODEL_PATH="./checkpoints/self_attention_final.pt"


# Choose: webrtc | deepfilternet | none
ENHANCEMENT_MODE=webrtc
FUSION_ENABLED=true

# Make sure to use GPU if available
DEVICE=cpu
