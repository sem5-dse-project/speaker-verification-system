PORT=8000
HOST=0.0.0.0
DEVICE=cpu
SAMPLE_RATE=16000
MAX_SECONDS=4.0
DEFAULT_THRESHOLD=0.45
# Speech activity gate — rejects ambient "empty" mic that still has RMS ~0.02–0.04
MIN_SPEECH_RMS=0.01
MIN_SPEECH_FRAME_RMS=0.08
MIN_SPEECH_MS=350
MIN_SPEECH_STRONG_FRAME_RMS=0.10
MIN_SPEECH_STRONG_MS=200
MIN_SPEECH_PEAK=0.40
ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
REPLAY_ENABLED=true
# REPLAY_CHECKPOINT=../../replay-cnn-baseline/experiments/inverted_mel_mixed_2017_pa2019/runs/inverted_mel_mixed/best_inverted_mel_mixed_2017_pa2019.pt
# REPLAY_MARGIN=0.10
# Optional LA (synthetic) LFCC — off by default (scores ~1.0 on browser mics).
# Soft: score only. Hard: can block as SYNTHETIC (lab ASVspoof files only).
LA_ENABLED=false
LA_HARD_GATE=false
# LA_CHECKPOINT=../../replay-cnn-baseline/experiments/lfcc_la2019/runs/lfcc_la/best_lfcc_la2019.pt
# LA_MARGIN=0.10

# Fusion Gate (cross-attention) -> cross_attention | noise_aware
FUSION_MODEL_TYPE=noise_aware
FUSION_MODEL_PATH="./checkpoints/noise_aware_fusion_fixed_final.pt"


# Choose: webrtc | deepfilternet | none
ENHANCEMENT_MODE=none
FUSION_ENABLED=none
