PORT=8000
HOST=0.0.0.0
DEVICE=cpu
# Comma-separated list of allowed CORS origins (Express backend + Vite frontend)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
SAMPLE_RATE=16000
MAX_SECONDS=4.0
DEFAULT_THRESHOLD=0.45
# Silero VAD preprocessing (before replay + ECAPA)
VAD_ENABLED=true
VAD_USE_ONNX=true
VAD_SPEECH_THRESHOLD=0.50
VAD_MIN_AUDIO_MS=250
VAD_MIN_SPEECH_MS=120
VAD_MIN_SILENCE_MS=120
VAD_SPEECH_PAD_MS=30
VAD_MIN_TOTAL_SPEECH_MS=300
# Speech activity gate — rejects ambient "empty" mic that still has RMS ~0.02–0.04
MIN_SPEECH_RMS=0.01
MIN_SPEECH_FRAME_RMS=0.08
MIN_SPEECH_MS=350
MIN_SPEECH_STRONG_FRAME_RMS=0.10
MIN_SPEECH_STRONG_MS=200
MIN_SPEECH_PEAK=0.40
ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
REPLAY_ENABLED=true
# REPLAY_CHECKPOINT=../../replay-cnn-baseline/experiments/inverted_mel_mixed_2017_pa2019/runs/inverted_mel_mixed/best_inverted_mel_mixed_2017_pa2019.pt
# REPLAY_MARGIN=0.10
# Optional LA (synthetic). Default backend: official AASIST (clone repo-root aasist/).
# Start with LA_HARD_GATE=false on browser mics; LFCC/WavLM often saturate (~1.0).
LA_ENABLED=false
LA_HARD_GATE=false
LA_BACKEND=aasist
# AASIST_ROOT=../../aasist
# LA_CHECKPOINT=../../aasist/models/weights/AASIST.pth
# LA_THRESHOLD=0.5
# LA_MARGIN=0.10
# Alternatives:
# LA_BACKEND=lfcc
# LA_CHECKPOINT=../../replay-cnn-baseline/experiments/lfcc_la2019/runs/lfcc_la/best_lfcc_la2019.pt
# LA_BACKEND=wavlm
# LA_CHECKPOINT=../../replay-cnn-baseline/experiments/wavlm_la2019/runs/wavlm_la/best_wavlm_la2019.pt

# Fusion Gate (cross-attention) -> cross_attention | noise_aware
FUSION_MODEL_TYPE=noise_aware
FUSION_MODEL_PATH="./checkpoints/noise_aware_fusion_fixed_final.pt"


# Choose: webrtc | deepfilternet | none
ENHANCEMENT_MODE=none
FUSION_ENABLED=none
