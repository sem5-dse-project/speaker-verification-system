# Copy to deploy/docker/.env.docker and edit secrets before compose up.
# For the minimal-RAM path (deploy/docker/pull-run.sh), use the prebuilt GHCR images:
IMAGE_REGISTRY=ghcr.io/sem5-dse-project
IMAGE_TAG=latest
FRONTEND_IMAGE_NAME=voice-auth-frontend
BACKEND_IMAGE_NAME=voice-auth-backend
ML_IMAGE_NAME=voice-auth-ml

DATABASE_USER=voice_auth
DATABASE_PASSWORD=password
DATABASE_NAME=voice_authentication
DATABASE_PORT=5432

JWT_SECRET=replace_with_a_long_random_secret

FRONTEND_PORT=8080
BACKEND_PORT=5000
ML_PORT=8000

ALLOWED_ORIGINS=http://localhost:8080,http://localhost

DEVICE=cpu
REPLAY_ENABLED=true
REPLAY_DETECTION=true
LA_ENABLED=false
LA_HARD_GATE=false
LA_BACKEND=lfcc
ENHANCEMENT_MODE=none
FUSION_ENABLED=false
